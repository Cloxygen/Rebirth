:root {
    --stage-0: #0b0a0e;
    --stage-1: #141119;
    --stage-2: #1d1826;

    --metal-hi: #c3b088;
    --metal: #8a7a5c;
    --metal-lo: #2f2819;
    --metal-line: #4a3f2b;

    --hp-hi: #e7414a;
    --hp: #b01820;
    --hp-lo: #4d070c;

    --rs-hi: #57b6f2;
    --rs: #1f6fc4;
    --rs-lo: #0a2549;

    --ess-hi: #fdfaf0;
    --ess: #d8cfa6;
    --ess-lo: #8f8560;

    --gold: #eeba4d;
    --gold-lo: #8a6412;
    --buff: #67c46f;
    --debuff: #b84ee0;
    --hex: #d84040;
    --ink: #efe7d6;
    --ink-dim: #9c9484;

    --orn: rgba(195, 176, 136, 0.3);

    --bar-hi: #2a2318;
    --bar-lo: #141009;
    --slot: #1c1626;
    --slot-line: #0b0810;
}
