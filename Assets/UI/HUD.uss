}

.tr-h { width: 9.9px; height: 1.1px; }
.tr-v { width: 1.1px; height: 9.9px; }
.tr-l { left: 0; }
.tr-r { right: 0; }
.tr-t { top: 0; }
.tr-b { bottom: 0; }

.tr-h.tr-l { --gradient-angle: 0; }
.tr-h.tr-r { --gradient-angle: 180; }
.tr-v.tr-t { --gradient-angle: 90; }
.tr-v.tr-b { --gradient-angle: 270; }

.bar-inlay {
    position: absolute;
    left: 16%; right: 16%;
    top: 1.65px;
    height: 1.1px;
