    translate: 0 1%;
    border-top-left-radius: 5.5px; border-top-right-radius: 5.5px;
    border-bottom-left-radius: 5.5px; border-bottom-right-radius: 5.5px;
    background-color: rgba(255, 255, 255, 0.04);
}

.slot-fill {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
