    margin-left: -12.65px;
    border-top-left-radius: 12.65px; border-top-right-radius: 12.65px;
    border-bottom-left-radius: 12.65px; border-bottom-right-radius: 12.65px;
    border-top-width: 1.38px; border-right-width: 1.38px;
    border-bottom-width: 1.38px; border-left-width: 1.38px;
    border-color: var(--metal);
    --fill-mode: 2;
    --fill-a: #2a2230;
    --fill-b: #100d16;
    --gradient-center-x: 0.5;
    --gradient-center-y: 0.35;
    --gradient-radius-x: 0.6;
    --gradient-radius-y: 0.6;
}

.mm-compass-n {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    translate: 0 1.61px;
    font-size: 13.2px;
    -unity-font-definition: url("project://database/Assets/Fonts/TeX%20Gyre%20Pagella%20SDF.asset?fileID=11400000&guid=1fd5e97170156ac4dac31725d9fb3f22&type=2#TeX%20Gyre%20Pagella%20SDF");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--gold);
    margin: 0;
    padding: 0;
}

.mm-zone-row {
    position: absolute;
    top: 184.8px;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.mm-zone {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 12px;
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 25px;
    color: var(--metal-hi);
    text-shadow: 0 3.3px 4.4px rgba(0, 0, 0, 0.9);
    margin: 0;
    padding: 0;
}

.belt {
    position: absolute;
    left: 1.6875%;
    top: 50%;
    translate: 0 -50%;
    flex-direction: column;
    align-items: center;
}

.belt-cord {
    position: absolute;
    top: 5.5px;
    bottom: 5.5px;
    left: 50%;
    width: 1.1px;
    translate: -50% 0;
    --fill-mode: 2;
    --fill-a: #c3b0884d;
    --fill-b: #c3b08800;
    --gradient-center-x: 0.5; --gradient-center-y: 0.5;
    --gradient-radius-x: 100; --gradient-radius-y: 0.5;
    --gradient-start: 0.76; --gradient-end: 1;
}

.belt-slot {
    width: 33px;
    height: 33px;
    flex-shrink: 0;
    margin-bottom: 9.9px;
    align-items: center;
    justify-content: center;
}

.belt-slot-last {
    margin-bottom: 0;
}

.belt-ring-edge {
    position: absolute;
    left: -3.3px; top: -3.3px;
    width: 39.6px; height: 39.6px;
    border-top-left-radius: 19.8px; border-top-right-radius: 19.8px;
    border-bottom-left-radius: 19.8px; border-bottom-right-radius: 19.8px;
    background-color: var(--metal);
}

.belt-ring-mid {
    position: absolute;
    left: -2.64px; top: -2.64px;
    width: 38.28px; height: 38.28px;
    border-top-left-radius: 19.14px; border-top-right-radius: 19.14px;
    border-bottom-left-radius: 19.14px; border-bottom-right-radius: 19.14px;
    background-color: var(--metal-lo);
}

.belt-ring-black {
    position: absolute;
    left: -1.1px; top: -1.1px;
    width: 35.2px; height: 35.2px;
    border-top-left-radius: 17.6px; border-top-right-radius: 17.6px;
    border-bottom-left-radius: 17.6px; border-bottom-right-radius: 17.6px;
    background-color: #0c0a10;
}

.belt-shadow {
    position: absolute;
    left: -11px; top: -11px;
    width: 55px; height: 55px;
    --radius: 16.5;
    --pad: 11;
    --fill-mode: 0;
    --fill-a: #00000000;
    --shadow-y: 2.2;
    --shadow-blur: 5.5;
    --shadow-color: #00000099;
}

.belt-face {
    position: absolute;
    left: 0; top: 0;
    width: 33px; height: 33px;
    border-top-left-radius: 16.5px; border-top-right-radius: 16.5px;
    border-bottom-left-radius: 16.5px; border-bottom-right-radius: 16.5px;
    --fill-mode: 2;
    --fill-a: #241d2b;
    --fill-b: #0c0910;
    --gradient-center-x: 0.5; --gradient-center-y: 0.26;
    --gradient-radius-x: 0.72; --gradient-radius-y: 0.72;
    --gradient-start: 0; --gradient-end: 0.72;
    --inset-y: 0; --inset-blur: 6.6; --inset-spread: 0; --inset-color: rgba(0, 0, 0, 0.9);
}

.belt-pool {
    position: absolute;
    left: 1.1px; top: 1.1px;
    width: 30.8px; height: 30.8px;
    border-top-left-radius: 15.4px; border-top-right-radius: 15.4px;
    border-bottom-left-radius: 15.4px; border-bottom-right-radius: 15.4px;
    --fill-mode: 2;
    --gradient-center-x: 0.5; --gradient-center-y: 1.08;
    --gradient-radius-x: 0.95; --gradient-radius-y: 0.95;
    --gradient-start: 0; --gradient-end: 0.9;
}

.belt-hp .belt-pool   { --fill-a: #b01820ad; --fill-b: #b0182000; }
.belt-mp .belt-pool   { --fill-a: #1f6fc4ad; --fill-b: #1f6fc400; }
.belt-cure .belt-pool { --fill-a: #67c46f8c; --fill-b: #67c46f00; }
.belt-rej .belt-pool  { --fill-a: #d8cfa67a; --fill-b: #d8cfa600; }

.belt-art {
    position: absolute;
    left: 6.6px; top: 6.6px;
    width: 19.8px; height: 19.8px;
    display: none;
}

.belt-icon {
    font-size: 18.7px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    text-shadow: 0 1.54px 1.98px rgba(0, 0, 0, 0.85);
}

.belt-cooldown {
    position: absolute;
    left: 0; top: 0;
    width: 33px; height: 33px;
    border-top-left-radius: 16.5px; border-top-right-radius: 16.5px;
    border-bottom-left-radius: 16.5px; border-bottom-right-radius: 16.5px;
    --radius: 16.5;
    --fill-mode: 0;
    --fill-a: #06060ac7;
    --sweep: 0;
}

.belt-key {
    position: absolute;
    left: 100%;
    top: 50%;
    translate: 0 -50%;
    margin-left: 6.6px;
    font-size: 9.35px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    color: var(--ink-dim);
    white-space: nowrap;
    text-shadow: 0 1.1px 1.1px #000;
}

.belt-count {
    position: absolute;
    bottom: -2.2px;
    right: -3.3px;
    font-size: 9.9px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    color: #ffffff;
    white-space: nowrap;
    text-shadow: 0 1.1px 2.2px #000;
    -unity-text-outline-width: 0.55px;
    -unity-text-outline-color: #000000;
}

.belt-out .belt-icon { opacity: 0.16; }
.belt-out .belt-art { opacity: 0.16; }
.belt-out .belt-pool { opacity: 0.22; }
.belt-out .belt-count { color: var(--ink-dim); }

.belt-slot:hover .belt-ring-mid { background-color: var(--metal); }
.belt-slot:hover .belt-ring-edge { background-color: var(--metal-hi); }

.xpbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10.69px;
    --fill-mode: 1;
    --fill-a: #0d0a1380;
    --fill-b: #05040880;
    --gradient-angle: 90;
    --inset-y: 1.1;
    --inset-blur: 2.2;
    --inset-spread: 0;
    --inset-color: rgba(0, 0, 0, 0.75);
    border-top-width: 1.1px;
    border-top-color: rgba(74, 63, 43, 0.7);
}

.xp-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --fill-mode: 1;
    --fill-a: #b3a97f;
    --fill-b: #8b8259;
    --gradient-angle: 90;
    --gradient-start: 0;
    --gradient-end: 0.55;
    --ov1-mode: 1;
    --ov1-a: #5f573800;
    --ov1-b: #5f5738ff;
    --ov1-angle: 90;
    --ov1-start: 0.55;
    --ov1-end: 1;
    --level-axis: 1;
    --level: 0.64;
}

.xp-ticks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.xp-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.1px;
    translate: -1.1px 0;
    background-color: rgba(4, 3, 6, 0.6);
}

.xp-tick-1 { left: 10%; }
.xp-tick-2 { left: 20%; }
.xp-tick-3 { left: 30%; }
.xp-tick-4 { left: 40%; }
.xp-tick-5 { left: 50%; }
.xp-tick-6 { left: 60%; }
.xp-tick-7 { left: 70%; }
.xp-tick-8 { left: 80%; }
.xp-tick-9 { left: 90%; }
.xp-tick-10 { left: 100%; }

.enemy-plates {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.plate {
    position: absolute;
    flex-direction: column;
    align-items: center;
}

.plate-title {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 3.6px;
}

.plate-rank {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-right: 2.9px;
    background-image: url("project://database/Assets/Textures/UI/ess_star.png");
    -unity-background-scale-mode: scale-to-fit;
}

.plate-name {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 10px;
    letter-spacing: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    color: #efe7d6;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
    -unity-text-outline-width: 0.12px;
    -unity-text-outline-color: #000000;
}

.plate-level {
    flex-shrink: 0;
    white-space: nowrap;
    margin-left: 2.2px;
    font-size: 9px;
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    color: #9c9484;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.plate-track {
    width: 100%;
    height: 13.7px;
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
    border-top-width: 1px; border-right-width: 1px;
    border-bottom-width: 1px; border-left-width: 1px;
    border-top-color: #0b0810; border-right-color: #0b0810;
    border-bottom-color: #0b0810; border-left-color: #0b0810;
    --fill-a: #100c17;
}

.plate-fill,
.plate-chip {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    --level-axis: 1;
    --level: 1;
}

.plate-fill {
    --fill-a: #e7414a;
}

.plate-chip {
    --fill-a: #90141a;
}

.damage-numbers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dmg {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
    transform-origin: center;
    font-size: 19.4px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/TeX%20Gyre%20Pagella%20SDF.asset?fileID=11400000&guid=1fd5e97170156ac4dac31725d9fb3f22&type=2#TeX%20Gyre%20Pagella%20SDF");
    color: #efe7d6;
    text-shadow: 0 1.4px 2.2px rgba(0, 0, 0, 1);
    -unity-text-outline-width: 0.3px;
    -unity-text-outline-color: #000000;
}

.sim {
    position: absolute;
    left: 13.2px;
    top: 13.2px;
    width: 275px;
    padding: 11px;
    background-color: rgba(10, 8, 12, 0.92);
    border-top-left-radius: 6.6px;
    border-top-right-radius: 6.6px;
    border-bottom-left-radius: 6.6px;
    border-bottom-right-radius: 6.6px;
    border-top-width: 1.1px;
    border-right-width: 1.1px;
    border-bottom-width: 1.1px;
    border-left-width: 1.1px;
    border-color: var(--metal-line);
}

.sim-title {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--ink-dim);
    margin-bottom: 8.8px;
}

.sim .unity-slider {
    margin-bottom: 8.8px;
}

.sim .unity-base-field__label {
    color: var(--ink-dim);
    min-width: 68.2px;
}

.inv {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
}

.inv-shadow {
    position: absolute;
    left: -26px;
    top: -26px;
    right: -26px;
    bottom: -26px;
    --radius: 0;
    --pad: 26;
    --fill-mode: 0;
    --fill-a: #00000000;
    --shadow-y: 0;
    --shadow-blur: 20;
    --shadow-color: rgba(0, 0, 0, 0.55);
}

.inv-plate {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    --radius: 0;
    --inset-y: 1.1; --inset-blur: 0; --inset-spread: 0; --inset-color: #ffffff0f;
    --inset2-y: 0; --inset2-blur: 11.09; --inset2-spread: 0; --inset2-color: #00000099;
    --fill-mode: 1;
    --fill-a: #191510;
    --fill-b: #090805;
    --gradient-angle: 90;
    --ov1-mode: 2;
    --ov1-center-x: 0.5; --ov1-center-y: 0.52;
    --ov1-radius-x: 0.45; --ov1-radius-y: 0.62;
    --ov1-a: #00000000;
    --ov1-b: #00000059;
    --ov2-mode: 2;
    --ov2-center-x: 0.5; --ov2-center-y: 0.14;
    --ov2-radius-x: 0.6; --ov2-radius-y: 0.19;
    --ov2-a: #cabc9f0a;
    --ov2-b: #cabc9f00;
}

.inv-edge {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
}

.inv-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 46px;
}

.inv-title {
    -unity-font-definition: url("project://database/Assets/Fonts/TeX%20Gyre%20Pagella%20SDF.asset?fileID=11400000&guid=1fd5e97170156ac4dac31725d9fb3f22&type=2#TeX%20Gyre%20Pagella%20SDF");
    -unity-text-align: middle-left;
}

.inv-body {
    flex-grow: 1;
    flex-direction: column;
}

.inv-sect {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.inv-sect-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    -unity-font-style: bold;
    margin-right: 10px;
    flex-shrink: 0;
}

.inv-sect-rule {
    flex-grow: 1;
    height: 1px;
    --fill-mode: 1;
    --gradient-angle: 0;
    --radius: 0;
}

.inv-bag-tools {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.inv-search {
    flex-grow: 1;
    justify-content: center;
    padding-left: 6px;
    padding-right: 6px;
    border-top-left-radius: 2px; border-top-right-radius: 2px;
    border-bottom-left-radius: 2px; border-bottom-right-radius: 2px;
}

.inv-search-input {
    flex-grow: 1;
    margin-top: 0; margin-bottom: 0; margin-left: 0; margin-right: 0;
    --unity-cursor-color: var(--metal-hi);
}

.inv-search-input.inv-caret-off {
    --unity-cursor-color: rgba(0, 0, 0, 0);
}

.inv-search-input .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;
    padding-top: 0; padding-bottom: 0; padding-left: 0; padding-right: 0;
    -unity-text-align: middle-left;
}

.inv-search-hint {
    position: absolute;
    left: 6px;
    top: 0; bottom: 0;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    opacity: 0.55;
}

.inv-sort {
    flex-shrink: 0;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 2px; border-top-right-radius: 2px;
    border-bottom-left-radius: 2px; border-bottom-right-radius: 2px;
}

.inv-sort:hover {
    border-top-color: var(--metal); border-right-color: var(--metal);
    border-bottom-color: var(--metal); border-left-color: var(--metal);
}

.inv-sort-art {
    position: absolute;
    left: 3px; top: 3px; right: 3px; bottom: 3px;
    background-size: contain;
}

.inv-sort-label {
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: nowrap;
}

.inv-gear {
    flex-shrink: 0;
    align-self: center;
}

.inv-slot {
    position: absolute;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 5.5px; border-top-right-radius: 5.5px;
    border-bottom-left-radius: 5.5px; border-bottom-right-radius: 5.5px;
    border-top-width: 1.1px; border-right-width: 1.1px;
    border-bottom-width: 1.1px; border-left-width: 1.1px;
    --fill-mode: 1;
    --gradient-angle: 90;
    --inset-y: 3.3; --inset-blur: 7.7; --inset-spread: 1.1; --inset-color: #000000ff;
    --inset2-y: 0.99; --inset2-blur: 0.77; --inset2-color: #000000ff;
    --inset3-y: -0.99; --inset3-blur: 0; --inset3-color: #ffffff0d;
}

.inv-slot:hover {
    border-top-color: var(--metal); border-right-color: var(--metal);
    border-bottom-color: var(--metal); border-left-color: var(--metal);
}

.inv-slot-icon {
    position: absolute;
    background-position-x: center;
    background-position-y: center;
    background-size: contain;
}

.inv-slot-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    letter-spacing: 2px;
    opacity: 0.5;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.inv-bag {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 18px;
}

.inv-well {
    flex-shrink: 0;
    --fill-mode: 1;
    --gradient-angle: 90;
    --inset-y: 5; --inset-blur: 11; --inset-spread: 1.1; --inset-color: rgba(0, 0, 0, 0.8);
    --inset2-y: 0.99; --inset2-blur: 0.77; --inset2-color: #000000ff;
    --inset3-y: -0.99; --inset3-blur: 0; --inset3-color: #ffffff0d;
    border-top-left-radius: 5.5px; border-top-right-radius: 5.5px;
    border-bottom-left-radius: 5.5px; border-bottom-right-radius: 5.5px;
}

.inv-bag-column {
    flex-shrink: 0;
    flex-direction: column;
}

.inv-grid {
    flex-grow: 1;
}

.inv-rule-line {
    position: absolute;
}

.inv-preview {
    position: absolute;
}

.inv-tile {
    position: absolute;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 4.4px; border-top-right-radius: 4.4px;
    border-bottom-left-radius: 4.4px; border-bottom-right-radius: 4.4px;
}

.inv-tile-art {
    position: absolute;
    left: 4px; top: 4px; right: 4px; bottom: 4px;
    background-size: contain;
}

.inv-essence-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 34px;
}

.inv-essence {
    flex-direction: row;
    align-items: center;
}

.inv-orb {
    flex-shrink: 0;
    margin-right: 9px;
    background-image: url("../Textures/UI/ess_star.png");
    background-size: cover;
}

.inv-essence-value {
    -unity-font-definition: url("project://database/Assets/Fonts/TeX%20Gyre%20Pagella%20SDF.asset?fileID=11400000&guid=1fd5e97170156ac4dac31725d9fb3f22&type=2#TeX%20Gyre%20Pagella%20SDF");
    margin-top: 0; margin-bottom: 0; margin-left: 0; margin-right: 0;
}

.inv-essence-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
    font-size: 9px;
    letter-spacing: 2.4px;
    margin-top: 0; margin-bottom: 0; margin-left: 0; margin-right: 0;
}

.inv-catcher {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.inv-ghost {
    position: absolute;
    left: 0;
    top: 0;
}

.tooltip {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 320px;
    max-height: 560px;
    padding-top: 9px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(10, 8, 12, 0.95);
    border-top-width: 1.1px; border-right-width: 1.1px;
    border-bottom-width: 1.1px; border-left-width: 1.1px;
    border-color: var(--metal-line);
    border-top-left-radius: 3.3px; border-top-right-radius: 3.3px;
    border-bottom-left-radius: 3.3px; border-bottom-right-radius: 3.3px;
}

.tooltip-title {
    -unity-font-definition: url("project://database/Assets/Fonts/Selawik%20SDF.asset?fileID=11400000&guid=a4e0cb5d19ff2a442bbc2cc35df5e68b&type=2#Selawik%20SDF");
