.login-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.login {
    width: 320px;
    padding: 20px 24px;
    background-color: var(--bar-lo);
    border-width: 1px;
    border-color: var(--metal-line);
    border-radius: 4px;
}

.login-title {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 20px;
    color: var(--gold);
    margin-bottom: 14px;
}

.login-caption {
    font-size: 12px;
    color: var(--ink-dim);
    margin: 6px 0 2px 0;
}

.login-field {
    margin: 0;
    font-size: 14px;
}

.login-field > #unity-text-input {
    background-color: var(--stage-1);
    border-color: var(--metal-line);
    color: var(--ink);
    padding: 4px 6px;
}

.login-reason {
    min-height: 18px;
    margin-top: 10px;
    white-space: normal;
    font-size: 12px;
    color: var(--hp-hi);
}

.login-buttons {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.login-button {
    flex-grow: 1;
    margin: 0 4px;
    padding: 6px 0;
    font-size: 14px;
    color: var(--ink);
    background-color: var(--bar-hi);
    border-color: var(--metal);
    border-radius: 3px;
}

.login-button:hover {
    border-color: var(--gold);
    color: var(--gold);
}
